{
  "manifest_version": 3,
  "name": "WhatsApp Task Notes",
  "version": "3.3.0",
  "description": "Collect new WhatsApp Web messages locally for a task summary.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "page-listener.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatsApp Task Notes"
  }
}
